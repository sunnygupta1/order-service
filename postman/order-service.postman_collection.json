{
  "info": {
    "_postman_id": "c1cbcb10-e530-4d26-b986-bb809334c792",
    "name": "Order Service",
    "description": "Postman collection for the order-service Spring Boot API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"iPhone 15\",\n  \"price\": 79999.0,\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/order/createorder",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "createorder"
          ]
        },
        "description": "Creates a new order."
      },
      "response": []
    },
    {
      "name": "Get All Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order"
          ]
        },
        "description": "Returns all saved orders."
      },
      "response": []
    },
    {
      "name": "Get Order By Id",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{bearerToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/order/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "order",
            "{{orderId}}"
          ]
        },
        "description": "Returns one order with user details from USER-SERVICE."
      },
      "response": []
    },
    {
      "name": "Actuator Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "description": "Checks service health through Spring Boot Actuator."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "bearerToken",
      "value": "paste-user-service-token-here",
      "type": "string"
    }
  ]
}
